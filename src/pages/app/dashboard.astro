---
import AppShell from "@/components/app/AppShell.astro";
import DashboardView from "@/components/app/dashboard/DashboardView";
import { getDashboardSummary } from "@/lib/services/dashboard/summary.server";
import { ensureAuthenticated } from "@/lib/utils/auth-redirect";
import { logError } from "@/lib/utils/error-handler";
import type { DashboardSummaryDTO } from "@/types";

const authContext = ensureAuthenticated(Astro.locals, Astro.url);

if ("redirect" in authContext) {
  return authContext.redirect;
}

const { supabase, user } = authContext;

const timezone = Astro.url.searchParams.get("tz");

let summary: DashboardSummaryDTO;

try {
  summary = await getDashboardSummary(supabase, user.id, { timezone });
} catch (error) {
  logError("pages/app/dashboard", error);
  summary = {
    streak: 0,
    trendDirection: "steady",
    trendDelta: 0,
    entries: [],
  };
}

const userEmail = user.email ?? null;
---

<AppShell title="MoodMate · Dashboard" userEmail={userEmail}>
  <DashboardView client:load summary={summary} initialTimezone={timezone ?? undefined} userEmail={userEmail} />
</AppShell>
