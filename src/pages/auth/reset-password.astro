---
import Layout from "@/layouts/Layout.astro";
import PublicAuthLayout from "@/components/auth/PublicAuthLayout.astro";
import ResetPasswordView from "@/components/auth/ResetPasswordView";

const pageCopy = {
  heading: "Ustaw nowe hasło",
  subheading: "Formularz resetu działa po wejściu z linku w wiadomości e-mail.",
};
---

<Layout title={pageCopy.heading}>
  <PublicAuthLayout heading={pageCopy.heading} subheading={pageCopy.subheading}>
    <ResetPasswordView client:load />
  </PublicAuthLayout>
</Layout>
