---
import Layout from "@/layouts/Layout.astro";
import PublicAuthLayout from "@/components/auth/PublicAuthLayout.astro";
import ForgotPasswordView from "@/components/auth/ForgotPasswordView";

const pageCopy = {
  heading: "Odzyskaj dostęp do konta",
  subheading: "Podaj email, a wyślemy link resetujący, jeśli konto istnieje.",
};
---

<Layout title={pageCopy.heading}>
  <PublicAuthLayout heading={pageCopy.heading} subheading={pageCopy.subheading}>
    <ForgotPasswordView client:load />
  </PublicAuthLayout>
</Layout>
